# Run `just <recipe>`; `just` alone lists recipes.
set shell := ["bash", "-cu"]

binary := "bin/server"
pkg    := "./cmd/server"
host   := env_var_or_default("HOST", "127.0.0.1")
port   := env_var_or_default("PORT", "8080")

default:
    @just --list

# Run the server (HOST/PORT env vars or defaults)
run:
    go run {{pkg}} -host {{host}} -port {{port}}

# Build the binary into ./bin/server
build:
    mkdir -p bin
    go build -o {{binary}} {{pkg}}

# Run all tests
test:
    go test ./...

# Run all tests with verbose output and race detector
test-verbose:
    go test -v -race ./...

# go vet
vet:
    go vet ./...

# gofmt every file in place
fmt:
    gofmt -w .

# go mod tidy
tidy:
    go mod tidy

# fmt + vet + test — run before committing
check: fmt vet test

# Remove build output
clean:
    rm -rf bin

# --- curl helpers (point at a running server) ---

# GET /healthz
healthz:
    curl -sS http://{{host}}:{{port}}/healthz | jq . || curl -sS http://{{host}}:{{port}}/healthz

# GET /api/widgets
list-widgets:
    curl -sS http://{{host}}:{{port}}/api/widgets | jq . || curl -sS http://{{host}}:{{port}}/api/widgets

# GET /api/widgets/{id}
get-widget id:
    curl -sS http://{{host}}:{{port}}/api/widgets/{{id}} | jq . || curl -sS http://{{host}}:{{port}}/api/widgets/{{id}}

# POST /api/widgets — name and price optional
create-widget name="sprocket" price="42":
    curl -sS -X POST http://{{host}}:{{port}}/api/widgets \
      -H 'content-type: application/json' \
      -d '{"name":"{{name}}","price":{{price}}}' | jq . || true
